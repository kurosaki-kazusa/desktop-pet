{
  "name": "ai-desktop-pet",
  "version": "1.0.1",
  "description": "AI 悬浮桌面宠物：提醒功能 + 常用命令记录器",
  "author": "vibe-coding",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "make-icon": "electron scripts/make-icon.js",
    "dist": "electron-builder --win"
  },
  "build": {
    "appId": "com.vibecoding.ai-desktop-pet",
    "productName": "AI桌宠",
    "directories": { "output": "dist" },
    "files": ["main.js", "preload.js", "renderer.js", "index.html", "styles.css"],
    "electronDownload": {
      "mirror": "https://npmmirror.com/mirrors/electron/"
    },
    "win": {
      "target": ["nsis"],
      "icon": "assets/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "AI桌宠"
    }
  },
  "dependencies": {
    "electron-store": "^8.2.0"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^26.15.3"
  }
}
