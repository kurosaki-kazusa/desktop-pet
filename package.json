{
  "name": "ai-desktop-pet",
  "version": "3.0.0",
  "description": "AI 悬浮桌面宠物与正式工作台：记事、提示词、日程、提醒、设置与大模型流式对话",
  "author": "vibe-coding",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "test:chat": "node scripts/test-chat.js",
    "test:storage": "node scripts/test-storage.js",
    "test:content": "node scripts/test-content.js",
    "test:workspace": "node scripts/test-workspace-window.js",
    "test:package": "node scripts/test-package.js",
    "make-icon": "electron scripts/make-icon.js",
    "dist": "electron-builder --win",
    "dist:clean": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/dist-temp.ps1"
  },
  "build": {
    "appId": "com.vibecoding.ai-desktop-pet",
    "productName": "AI桌宠",
    "directories": { "output": "dist" },
    "asar": true,
    "files": ["main.js", "main/**/*", "preload.js", "renderer.js", "index.html", "styles.css", "workspace.html", "workspace.css", "workspace.js", "task-rules.js", "chat.js", "assets/**/*", "!assets/ScreenShot_2026-08-24_100223_551.png"],
    "electronDownload": {
      "mirror": "https://registry.npmmirror.com/-/binary/electron/"
    },
    "win": {
      "target": ["nsis"],
      "icon": "assets/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "AI桌宠"
    }
  },
  "dependencies": {
    "electron-store": "^8.2.0"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^26.15.3"
  }
}
